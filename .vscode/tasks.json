{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "type": "shell",
            "command": "cmake --build out/build/horizons --config Debug",
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "problemMatcher": [
                "$gcc"
            ],
            "detail": "Build the entire project",
            "isBackground": false
        },
        {
            "type": "cppbuild",
            "label": "C/C++: g++.exe build active file",
            "command": "C:/msys64/ucrt64/bin/g++.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${file}",
                "-o",
                "${fileDirname}\\${fileBasenameNoExtension}.exe"
            ],
            "options": {
                "cwd": "C:/msys64/ucrt64/bin"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Task generated by Debugger."
        },
        {
            "label": "tests: build memory node",
            "type": "shell",
            "command": "cmake --preset horizons-memory; cmake --build --preset horizons-build-memory",
            "problemMatcher": [
                "$gcc"
            ],
            "detail": "Configure and build memory test node"
        },
        {
            "label": "tests: build vulkan/instance node",
            "type": "shell",
            "command": "cmake --preset horizons-vulkan-instance; cmake --build --preset horizons-build-vulkan-instance",
            "problemMatcher": [
                "$gcc"
            ],
            "detail": "Configure and build vulkan/instance test node"
        },
        {
            "label": "tests: build vulkan/phys_device node",
            "type": "shell",
            "command": "cmake --preset horizons-vulkan-phys-device; cmake --build --preset horizons-build-vulkan-phys-device",
            "problemMatcher": [
                "$gcc"
            ],
            "detail": "Configure and build vulkan/phys_device test node"
        },
        {
            "label": "tests: build all test nodes",
            "dependsOrder": "sequence",
            "dependsOn": [
                "tests: build memory node",
                "tests: build vulkan/instance node",
                "tests: build vulkan/phys_device node"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "problemMatcher": [],
            "detail": "One-click build for all dedicated test nodes"
        }
    ]
}