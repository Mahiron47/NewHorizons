{
	"version": 8,
	"configurePresets": [
		{
			"name": "horizons-base",
			"hidden": true,
			"cacheVariables": {
				"CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/horizons",
				"CMAKE_BUILD_TYPE": "Debug"
			},
			"generator": "Ninja"
		},
		{
			"name": "horizons1",
			"displayName": "GCC",
			"description": "Using compilers: C = C:\\msys64\\ucrt64\\bin\\gcc.exe, CXX = C:\\msys64\\ucrt64\\bin\\g++.exe",
			"inherits": "horizons-base",
			"cacheVariables": {
				"CMAKE_C_COMPILER": "C:/msys64/ucrt64/bin/gcc.exe",
				"CMAKE_CXX_COMPILER": "C:/msys64/ucrt64/bin/g++.exe",
				"CMAKE_CXX_FLAGS": "-std=c++26"
			},
			"binaryDir": "${sourceDir}/out/build/horizons-gcc"
		},
		{
			"name": "horizons2",
			"displayName": "Clang",
			"description": "Using compilers: C = C:\\msys64\\ucrt64\\bin\\clang.exe, CXX = C:\\msys64\\ucrt64\\bin\\clang++.exe",
			"inherits": "horizons-base",
			"cacheVariables": {
				"CMAKE_C_COMPILER": "C:/msys64/ucrt64/bin/clang.exe",
				"CMAKE_CXX_COMPILER": "C:/msys64/ucrt64/bin/clang++.exe"
			},
			"binaryDir": "${sourceDir}/out/build/horizons-clang"
		},
		{
		    "name": "horizons-reflection",
		    "displayName": "Clang Reflection (P2996)",
		    "description": "Experimental Clang with C++26 Reflection",
		    "inherits": "horizons-base",
		    "cacheVariables": {
		        "CMAKE_C_COMPILER": "C:/libraries/clang/bin/clang.exe",
		        "CMAKE_CXX_COMPILER": "C:/libraries/clang/bin/clang++.exe",
		        "CMAKE_CXX_FLAGS": "-std=c++2c -freflection -fexpansion-statements"
		    },
		    "binaryDir": "${sourceDir}/out/build/horizons-reflection"
		}
	]
}